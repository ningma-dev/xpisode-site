# Copy to ~/.config/xirra/env and chmod 600. Never commit the real file.

# Feishu self-built app: Developer Console -> Credentials & Basic Info
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# The read-only xpisode panel over the central store
PANEL_URL=http://127.0.0.1:8090

# An OpenAI-compatible chat API (e.g. DashScope compatible mode, DeepSeek). Empty: free questions off.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# The group the daily report goes to: add the bot to the group, send it "群号".
REPORT_CHAT_ID=
REPORT_AT=09:00

# The writable panel over the central host's data root (services/feishu/deploy/hub.sh). Empty: the bot cannot write.
WRITE_PANEL_URL=
