#!/usr/bin/env bash
# Pin each listed PCI device's interrupts to one CPU. Keyed on the PCI address, not the IRQ
# number, which can change between boots. Installed by host/setup.sh --pin-irqs.
#     xpisode-pin-irqs 0000:0d:00.0=4 0000:79:00.4=8 ...
set -euo pipefail
if systemctl is-active --quiet irqbalance 2>/dev/null; then
  echo "xpisode-pin-irqs: irqbalance is active and will move these interrupts again" >&2
fi
status=0
for pair in "$@"; do
  pci="${pair%%=*}" cpu="${pair#*=}"
  dev="/sys/bus/pci/devices/$pci"
  if [[ ! -d "$dev" ]]; then
    echo "xpisode-pin-irqs: no PCI device $pci" >&2
    status=1
    continue
  fi
  irqs=()
  if [[ -d "$dev/msi_irqs" ]]; then
    for f in "$dev"/msi_irqs/*; do [[ -e "$f" ]] && irqs+=("$(basename "$f")"); done
  fi
  [[ ${#irqs[@]} -gt 0 ]] || irqs=("$(cat "$dev/irq")")
  for irq in "${irqs[@]}"; do
    [[ -d "/proc/irq/$irq" ]] || continue  # allocated but never requested: serves nothing
    if echo "$cpu" >"/proc/irq/$irq/smp_affinity_list" 2>/dev/null; then
      echo "$pci irq $irq -> cpu $(cat "/proc/irq/$irq/effective_affinity_list" 2>/dev/null || echo "$cpu")"
    else
      echo "xpisode-pin-irqs: could not pin $pci irq $irq to cpu $cpu" >&2
      status=1
    fi
  done
done
exit $status
