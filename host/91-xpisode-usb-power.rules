# xpisode: keep the D405s and the CAN adapters out of USB autosuspend (the kernel default here is
# usbcore.autosuspend=2), and keep ModemManager from probing the CAN adapters.
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="8086", ATTR{idProduct}=="0b5b", TEST=="power/control", ATTR{power/control}="on"
# The kernel's camera driver (uvcvideo) sets power/control back to "auto" when it binds a camera
# (uvc_probe calls usb_enable_autosuspend), so for the D405s the line above does not hold. A
# negative delay means "never autosuspend" and the driver does not touch it.
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="8086", ATTR{idProduct}=="0b5b", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="606f", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|change", SUBSYSTEM=="usb", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="606f", ENV{ID_MM_DEVICE_IGNORE}="1"
