# Host facts of station yam_3 (machine ubuntu3), surveyed 2026-11-13. Plain KEY=value bash, no
# code: sourced by scripts/station_env.sh, host/setup.sh and host/doctor.sh. The station's name
# is this directory's name (robots/yam_3); machine.md is the full snapshot.

# The machine this station runs on (`hostname -s`), for the record. The machine finds its station
# through the uncommitted .station file in the repo root.
XPISODE_HOST=ubuntu3

# Data root: ~/xpisode-data of user ubuntu = /home/ubuntu/xpisode-data, a directory on the NVMe
# root filesystem (3.1 T free). Not on the NTFS disks.

# The xHCI controllers the cameras and the CAN adapters are on, "PCI-address CPU": the CPU that
# serves each one's interrupts. Measured with host/xhci_list.sh (affinity 0-15, irqbalance
# inactive). If pinned (sudo host/setup.sh --pin-irqs) this is also the pinning target.
# Re-measure after recabling.
XPISODE_DEVICE_XHCI=(
  "0000:0d:00.0 4"   # IRQ 45: D405 262723072517 (USB 2-4), 262723077218 (USB 2-5)
  "0000:79:00.4 8"   # IRQ 79: D405 262723071989 (USB 10-2)
  "0000:0f:00.0 5"   # IRQ 53: CAN 208F3783454650062, 20833395594E50182, 20673463584550182, 20603463584550182
)
# Background work (proxies, uploads) runs on every CPU except these and their SMT siblings
# (scripts/station_env.sh reads the siblings from sysfs; on this machine N and N+8):
# expected 1-3,6,7,9-11,14,15. To override, set XPISODE_BACKGROUND_CPUS here.
