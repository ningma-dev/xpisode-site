# Host facts of station yam_1 (machine ubuntu1), surveyed 2026-11-13. Plain KEY=value bash, no
# code: sourced by scripts/station_env.sh, host/setup.sh and host/doctor.sh. machine.md is the
# full snapshot.

# The name the team uses for this machine (ssh alias), for the record. The machine finds its station
# through the uncommitted .station file in the repo root.
XPISODE_HOST=ubuntu1

# The USB controllers the cameras and the CAN adapters are on, "PCI-address CPU": the CPU that
# serves each one's interrupts (host/xhci_list.sh). Re-measure after recabling.
XPISODE_DEVICE_XHCI=(
  "0000:0f:00.0 5"   # IRQ 53: D405 262723071809 (USB 4-5.1), 262723076941 (4-5.3), 262723078069 (4-5.4)
  # CAN adapters: none plugged in at the survey (2026-11-13); add their controller once they are.
)
