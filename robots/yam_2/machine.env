# Host facts of station yam_2 (machine ubuntu2), surveyed 2026-11-13 (after re-cabling). Plain
# KEY=value bash, no code: sourced by scripts/station_env.sh, host/setup.sh and host/doctor.sh.
# The station's name is this directory's name (robots/yam_2); machine.md is the full snapshot.

# The machine this station runs on (`hostname -s`); scripts/station_env.sh picks this file by it.
XPISODE_HOST=ubuntu2

# Data root: ~/xpisode-data of user ubuntu = /home/ubuntu/xpisode-data, a directory on the NVMe
# root filesystem (3.1 T free).

# The xHCI controllers the cameras and the CAN adapters are on, "PCI-address CPU": the CPU that
# serves each one's interrupts. Measured with host/xhci_list.sh. If pinned
# (sudo host/setup.sh --pin-irqs) this is also the pinning target. Re-measure after recabling.
XPISODE_DEVICE_XHCI=(
  "0000:0d:00.0 4"   # IRQ 45: D405 260323074516 (USB 2-5); CAN 20843399594E50182 (USB 1-4)
  "0000:0f:00.0 5"   # IRQ 53: D405 255323071678 (4-5.3), 262723072302 (4-5.4); CAN 20973485584550182 (3-4.1), 206B3393594E50182 (3-4.2)
  "0000:79:00.4 8"   # IRQ 79: CAN 20743395594E50182 (USB 9-2)
)
# Background work (proxies, uploads) runs on every CPU except these and their SMT siblings
# (scripts/station_env.sh reads the siblings from sysfs; on this machine N and N+8):
# expected 1-3,6,7,9-11,14,15. To override, set XPISODE_BACKGROUND_CPUS here.
