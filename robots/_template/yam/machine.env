# Host facts of this station. Plain KEY=value bash, sourced by scripts/station_env.sh,
# host/setup.sh and host/doctor.sh.

# The name the team uses for this machine (ssh alias), for the record.
XPISODE_HOST=FILL

# The USB controllers the cameras and the CAN adapters are on, one line each: "<PCI address> <CPU>",
# as host/xhci_list.sh prints them (the xhci column, and the CPU after the colon in irq:cpu).
XPISODE_DEVICE_XHCI=(
)
